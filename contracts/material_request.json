{
  "$schema": "contract.v1",
  "name": "material_request",
  "label": "Material Request",
  "version": "1.0.0",
  "description": "Raised by a Site Supervisor (or a Project Manager, in which case it is auto-approved) for materials at a site.",
  "fields": [
    {
      "field": "refNo",
      "label": "Reference",
      "type": "string",
      "input": "readonly-badge",
      "required": true,
      "help": "MR-YYYY-NNNN, generated server-side"
    },
    {
      "field": "projectId",
      "label": "Project",
      "type": "reference",
      "input": "select",
      "required": true,
      "relation": {
        "table": "projects"
      },
      "optionsFrom": "projects"
    },
    {
      "field": "siteId",
      "label": "Site",
      "type": "reference",
      "input": "select",
      "required": false,
      "relation": {
        "table": "sites"
      },
      "optionsFrom": "sites",
      "help": "Optional if the project has no separate sites"
    },
    {
      "field": "items",
      "label": "Items",
      "type": "array",
      "input": "item-list",
      "required": true,
      "items": {
        "type": "object",
        "fields": [
          {
            "field": "itemName",
            "label": "Item",
            "type": "string",
            "input": "autocomplete",
            "required": true,
            "optionsFrom": "project_items",
            "validation": {
              "minLength": 1,
              "maxLength": 180
            }
          },
          {
            "field": "description",
            "label": "Description",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 300
            }
          },
          {
            "field": "hsnSacCode",
            "label": "HSN/SAC Code",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 20
            }
          },
          {
            "field": "quantity",
            "label": "Quantity",
            "type": "number",
            "input": "number",
            "required": true,
            "validation": {
              "min": 0.001
            }
          },
          {
            "field": "unit",
            "label": "Unit",
            "type": "string",
            "input": "select",
            "required": true,
            "validation": {
              "enum": [
                "bags",
                "MT",
                "kg",
                "nos",
                "cum",
                "brass",
                "sqm",
                "ltr",
                "rmt"
              ]
            }
          },
          {
            "field": "projectItemId",
            "label": "BOQ item",
            "type": "reference",
            "input": "hidden",
            "required": false,
            "relation": {
              "table": "project_items"
            }
          }
        ]
      },
      "validation": {
        "minLength": 1
      }
    },
    {
      "field": "priority",
      "label": "Priority",
      "type": "enum",
      "input": "select",
      "required": true,
      "validation": {
        "enum": [
          "low",
          "normal",
          "high",
          "urgent"
        ]
      },
      "default": "normal"
    },
    {
      "field": "requiredBy",
      "label": "Required by",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "status",
      "label": "Status",
      "type": "enum",
      "input": "readonly-badge",
      "required": true,
      "validation": {
        "enum": [
          "draft",
          "pending",
          "queried",
          "rejected",
          "ready_for_cc",
          "review_cc",
          "ready_for_po",
          "review_po",
          "pending_po",
          "delivery_processing",
          "delivered"
        ]
      },
      "default": "draft"
    }
  ],
  "statuses": [
    "draft",
    "pending",
    "queried",
    "rejected",
    "ready_for_cc",
    "review_cc",
    "ready_for_po",
    "review_po",
    "pending_po",
    "delivery_processing",
    "delivered"
  ],
  "lifecycle": {
    "initial": "draft",
    "states": {
      "draft": {
        "kind": "editable",
        "owner": "creator",
        "terminal": false,
        "badge": {
          "label": "Draft",
          "variant": "secondary"
        }
      },
      "pending": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Pending",
          "variant": "default"
        }
      },
      "queried": {
        "kind": "editable",
        "owner": "creator",
        "terminal": false,
        "badge": {
          "label": "Queried",
          "variant": "destructive"
        }
      },
      "rejected": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Rejected",
          "variant": "destructive"
        }
      },
      "ready_for_cc": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Ready for CC",
          "variant": "default"
        }
      },
      "review_cc": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Review CC",
          "variant": "default"
        }
      },
      "ready_for_po": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Ready for PO",
          "variant": "default"
        }
      },
      "review_po": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Review PO",
          "variant": "default"
        }
      },
      "pending_po": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "PO Issued",
          "variant": "default"
        }
      },
      "delivery_processing": {
        "kind": "in_transit",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "In Delivery",
          "variant": "default"
        }
      },
      "delivered": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Delivered",
          "variant": "default"
        }
      }
    },
    "transitions": [
      {
        "name": "submit",
        "label": "Submit Request",
        "from": [
          "draft",
          "queried"
        ],
        "to": "pending",
        "roles": [
          "site_supervisor",
          "project_manager",
          "admin"
        ],
        "actor": "creator",
        "guards": [
          "hasAtLeastOneItem"
        ]
      },
      {
        "name": "approve",
        "label": "Approve Request",
        "from": [
          "pending"
        ],
        "to": "ready_for_cc",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver"
      },
      {
        "name": "reject",
        "label": "Reject Request",
        "from": [
          "pending"
        ],
        "to": "rejected",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "requiresNote": true
      },
      {
        "name": "query",
        "label": "Query Request",
        "from": [
          "pending"
        ],
        "to": "queried",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "requiresNote": true
      },
      {
        "name": "resubmit",
        "label": "Resubmit Request",
        "from": [
          "draft",
          "queried"
        ],
        "to": "pending",
        "roles": [
          "site_supervisor",
          "project_manager",
          "admin"
        ],
        "actor": "creator",
        "guards": [
          "hasAtLeastOneItem"
        ]
      },
      {
        "name": "review_on_cc",
        "label": "Move to CC Review",
        "from": [
          "ready_for_cc",
          "review_cc"
        ],
        "to": "review_cc",
        "roles": [
          "procurement_officer",
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "advance_on_cc_approval",
        "label": "Advance to PO Ready",
        "from": [
          "review_cc"
        ],
        "to": "ready_for_po",
        "roles": [
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "reset_on_cc_reject",
        "label": "Reset to CC Ready",
        "from": [
          "review_cc"
        ],
        "to": "ready_for_cc",
        "roles": [
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "review_on_po",
        "label": "Move to PO Review",
        "from": [
          "ready_for_po",
          "review_po"
        ],
        "to": "review_po",
        "roles": [
          "procurement_officer",
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "advance_on_po_approval",
        "label": "Advance to Pending PO",
        "from": [
          "review_po",
          "ready_for_po"
        ],
        "to": "pending_po",
        "roles": [
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "reset_on_po_reject",
        "label": "Reset to PO Ready",
        "from": [
          "review_po",
          "pending_po"
        ],
        "to": "ready_for_po",
        "roles": [
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "advance_on_dc",
        "label": "Advance to Delivery In Progress",
        "from": [
          "pending_po",
          "ready_for_po"
        ],
        "to": "delivery_processing",
        "roles": [
          "procurement_officer",
          "project_manager",
          "admin"
        ]
      },
      {
        "name": "process_delivery",
        "label": "Process Delivery Receipt",
        "from": [
          "delivery_processing",
          "pending_po"
        ],
        "to": "delivery_processing",
        "roles": [
          "site_supervisor",
          "procurement_officer",
          "admin"
        ]
      },
      {
        "name": "close_on_receipt",
        "label": "Close on Full Receipt",
        "from": [
          "delivery_processing",
          "pending_po"
        ],
        "to": "delivered",
        "roles": [
          "site_supervisor",
          "procurement_officer",
          "admin"
        ]
      },
      {
        "name": "close_on_short_close",
        "label": "Close on Short Close",
        "from": [
          "pending_po",
          "delivery_processing"
        ],
        "to": "delivered",
        "roles": [
          "project_manager",
          "admin"
        ]
      }
    ]
  },
  "relations": {
    "projectId": "projects",
    "siteId": "sites"
  },
  "indexes": [
    [
      "refNo"
    ],
    [
      "status"
    ],
    [
      "siteId",
      "status"
    ],
    [
      "createdBy",
      "status"
    ],
    [
      "projectId"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
