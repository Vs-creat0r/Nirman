{
  "$schema": "contract.v1",
  "name": "material_request",
  "label": "Material Request",
  "version": "1.0.0",
  "description": "Raised by a Site Supervisor (or a Project Manager, in which case it is auto-approved) for materials at a site.",
  "fields": [
    {
      "field": "refNo",
      "label": "Reference",
      "type": "string",
      "input": "readonly-badge",
      "required": true,
      "help": "MR-YYYY-NNNN, generated server-side"
    },
    {
      "field": "projectId",
      "label": "Project",
      "type": "reference",
      "input": "select",
      "required": true,
      "relation": {
        "table": "projects"
      },
      "optionsFrom": "projects"
    },
    {
      "field": "siteId",
      "label": "Site",
      "type": "reference",
      "input": "select",
      "required": false,
      "relation": {
        "table": "sites"
      },
      "optionsFrom": "sites",
      "help": "Optional if the project has no separate sites"
    },
    {
      "field": "items",
      "label": "Items",
      "type": "array",
      "input": "item-list",
      "required": true,
      "items": {
        "type": "object",
        "fields": [
          {
            "field": "itemName",
            "label": "Item",
            "type": "string",
            "input": "autocomplete",
            "required": true,
            "optionsFrom": "project_items",
            "validation": {
              "minLength": 1,
              "maxLength": 180
            }
          },
          {
            "field": "description",
            "label": "Description",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 300
            }
          },
          {
            "field": "hsnSacCode",
            "label": "HSN/SAC Code",
            "type": "string",
            "input": "text",
            "required": true,
            "validation": {
              "maxLength": 20
            }
          },
          {
            "field": "quantity",
            "label": "Quantity",
            "type": "number",
            "input": "number",
            "required": true,
            "validation": {
              "min": 0.001
            }
          },
          {
            "field": "unit",
            "label": "Unit",
            "type": "string",
            "input": "select",
            "required": true,
            "validation": {
              "enum": [
                "bags",
                "MT",
                "kg",
                "nos",
                "cum",
                "brass",
                "sqm",
                "ltr",
                "rmt"
              ]
            }
          },
          {
            "field": "projectItemId",
            "label": "BOQ item",
            "type": "reference",
            "input": "hidden",
            "required": false,
            "relation": {
              "table": "project_items"
            }
          }
        ]
      },
      "validation": {
        "minLength": 1
      }
    },
    {
      "field": "priority",
      "label": "Priority",
      "type": "enum",
      "input": "select",
      "required": true,
      "validation": {
        "enum": [
          "low",
          "normal",
          "high",
          "urgent"
        ]
      },
      "default": "normal"
    },
    {
      "field": "requiredBy",
      "label": "Required by",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "notes",
      "label": "Notes",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "status",
      "label": "Status",
      "type": "enum",
      "input": "readonly-badge",
      "required": true,
      "validation": {
        "enum": [
          "draft",
          "pending",
          "queried",
          "rejected",
          "ready_for_cc",
          "review_cc",
          "ready_for_po",
          "review_po",
          "pending_po",
          "delivery_processing",
          "delivered"
        ]
      },
      "default": "draft"
    }
  ],
  "statuses": [
    "draft",
    "pending",
    "queried",
    "rejected",
    "ready_for_cc",
    "review_cc",
    "ready_for_po",
    "review_po",
    "pending_po",
    "delivery_processing",
    "delivered"
  ],
  "relations": {
    "projectId": "projects",
    "siteId": "sites"
  },
  "indexes": [
    [
      "refNo"
    ],
    [
      "status"
    ],
    [
      "siteId",
      "status"
    ],
    [
      "createdBy",
      "status"
    ],
    [
      "projectId"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
