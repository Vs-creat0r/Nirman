{
  "$schema": "contract.v1",
  "name": "rfq",
  "label": "Request for Quotation",
  "version": "1.0.0",
  "description": "Sent to vendors to collect material price quotes prior to Cost Comparison.",
  "fields": [
    {
      "field": "refNo",
      "label": "Reference",
      "type": "string",
      "input": "readonly-badge",
      "required": true
    },
    {
      "field": "projectId",
      "label": "Project",
      "type": "reference",
      "input": "select",
      "required": true,
      "relation": {
        "table": "projects"
      },
      "optionsFrom": "projects"
    },
    {
      "field": "siteId",
      "label": "Site",
      "type": "reference",
      "input": "select",
      "required": false,
      "relation": {
        "table": "sites"
      },
      "optionsFrom": "sites"
    },
    {
      "field": "sourceMrId",
      "label": "Source Material Request",
      "type": "reference",
      "input": "readonly",
      "required": false,
      "relation": {
        "table": "material_request"
      }
    },
    {
      "field": "vendorIds",
      "label": "Invited Vendors",
      "type": "array",
      "input": "multi-select",
      "required": true,
      "relation": {
        "table": "vendors"
      },
      "optionsFrom": "vendors",
      "validation": {
        "minLength": 1
      }
    },
    {
      "field": "requestedItems",
      "label": "Requested Items",
      "type": "array",
      "input": "item-list",
      "required": true,
      "items": {
        "type": "object",
        "fields": [
          {
            "field": "itemName",
            "label": "Item",
            "type": "string",
            "input": "text",
            "required": true,
            "validation": {
              "minLength": 1,
              "maxLength": 180
            }
          },
          {
            "field": "category",
            "label": "Category",
            "type": "string",
            "input": "text",
            "required": false
          },
          {
            "field": "quantity",
            "label": "Qty",
            "type": "number",
            "input": "number",
            "required": true,
            "validation": {
              "min": 0.001
            }
          },
          {
            "field": "unit",
            "label": "Unit",
            "type": "string",
            "input": "select",
            "required": true,
            "validation": {
              "enum": [
                "bags",
                "MT",
                "kg",
                "nos",
                "cum",
                "brass",
                "sqm",
                "ltr",
                "rmt"
              ]
            }
          },
          {
            "field": "projectItemId",
            "label": "BOQ Item",
            "type": "reference",
            "input": "hidden",
            "required": false,
            "relation": {
              "table": "project_items"
            }
          },
          {
            "field": "description",
            "label": "Description / Specs",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 300
            }
          }
        ]
      },
      "validation": {
        "minLength": 1
      }
    },
    {
      "field": "dueDate",
      "label": "Quotes Due Date",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "sentVia",
      "label": "Sent via",
      "type": "enum",
      "input": "select",
      "required": false,
      "validation": {
        "enum": [
          "whatsapp",
          "email",
          "manual"
        ]
      }
    },
    {
      "field": "sentAt",
      "label": "Sent at",
      "type": "date",
      "input": "readonly",
      "required": false
    },
    {
      "field": "notes",
      "label": "Notes / Instructions",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "status",
      "label": "Status",
      "type": "enum",
      "input": "readonly-badge",
      "required": true,
      "validation": {
        "enum": [
          "draft",
          "open",
          "closed",
          "archived"
        ]
      },
      "default": "draft"
    }
  ],
  "statuses": [
    "draft",
    "open",
    "closed",
    "archived"
  ],
  "lifecycle": {
    "initial": "draft",
    "states": {
      "draft": {
        "kind": "editable",
        "owner": "creator",
        "terminal": false,
        "badge": {
          "label": "Draft",
          "variant": "secondary"
        }
      },
      "open": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Open",
          "variant": "default"
        }
      },
      "closed": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Closed",
          "variant": "default"
        }
      },
      "archived": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Archived",
          "variant": "destructive"
        }
      }
    },
    "transitions": [
      {
        "name": "issue",
        "label": "Issue RFQ",
        "from": [
          "draft"
        ],
        "to": "open",
        "roles": [
          "procurement_officer",
          "admin"
        ],
        "actor": "creator"
      },
      {
        "name": "close",
        "label": "Close RFQ",
        "from": [
          "open"
        ],
        "to": "closed",
        "roles": [
          "procurement_officer",
          "admin"
        ],
        "actor": "creator"
      },
      {
        "name": "archive",
        "label": "Archive RFQ",
        "from": [
          "open",
          "closed"
        ],
        "to": "archived",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "creator"
      }
    ]
  },
  "relations": {
    "sourceMrId": "material_request",
    "projectId": "projects",
    "siteId": "sites",
    "vendorIds": "vendors"
  },
  "indexes": [
    [
      "refNo"
    ],
    [
      "status"
    ],
    [
      "projectId",
      "status"
    ],
    [
      "projectId"
    ],
    [
      "sourceMrId"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
