{
  "$schema": "contract.v1",
  "name": "grn",
  "label": "Goods Receipt Note",
  "version": "1.0.0",
  "description": "Confirmation of goods receipt at the site. Auto-created when the Site Supervisor clicks 'Delivered' on an out-for-delivery request.",
  "fields": [
    { "field": "poId", "label": "Purchase Order", "type": "reference", "input": "select", "required": true, "optionsFrom": "purchase_order", "relation": { "table": "purchase_order" } },
    { "field": "dcId", "label": "Delivery Challan", "type": "reference", "input": "select", "required": false, "optionsFrom": "delivery_challan", "relation": { "table": "delivery_challan" }, "help": "Optional — links the GRN to the dispatch record." },
    { "field": "receivedItems", "label": "Received Items", "type": "array", "input": "item-list", "required": true, "items": { "type": "object", "fields": [
      { "field": "itemName", "label": "Item", "type": "string", "input": "autocomplete", "optionsFrom": "project_items", "required": true },
      { "field": "receivedQty", "label": "Received Qty", "type": "number", "input": "number", "required": true, "validation": { "min": 0 } },
      { "field": "unit", "label": "Unit", "type": "string", "input": "text", "required": true }
    ]} },
    { "field": "photos", "label": "Unloading Photos", "type": "array", "input": "file", "required": false, "items": { "type": "string" } },
    { "field": "invoiceNumber", "label": "Invoice No", "type": "string", "input": "text", "required": false },
    { "field": "confirmedBy", "label": "Confirmed By", "type": "reference", "input": "select", "required": false, "optionsFrom": "users", "relation": { "table": "users" } },
    { "field": "confirmedAt", "label": "Confirmed At", "type": "date", "input": "date", "required": false },
    { "field": "status", "label": "Status", "type": "enum", "input": "readonly-badge", "required": true, "default": "pending" }
  ],
  "statuses": ["pending", "confirmed"],
  "relations": { "poId": "purchase_order", "dcId": "delivery_challan", "confirmedBy": "users" },
  "indexes": [ ["poId"], ["status"] ],
  "audit": { "enabled": true, "trackCreatedBy": true, "trackUpdatedAt": true }
}
