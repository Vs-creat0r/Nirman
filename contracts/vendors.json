{
  "$schema": "contract.v1",
  "name": "vendors",
  "label": "Vendor",
  "version": "1.0.0",
  "description": "A supplier in the vendor master.",
  "fields": [
    {
      "field": "name",
      "label": "Vendor name",
      "type": "string",
      "input": "text",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 180
      },
      "help": "Must be unique; uniqueness is enforced in the mutation, not in Zod"
    },
    {
      "field": "contactPerson",
      "label": "Contact person",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 120
      }
    },
    {
      "field": "phone",
      "label": "Phone",
      "type": "string",
      "input": "text",
      "required": true,
      "validation": {
        "pattern": "^[0-9+\\-\\s]{7,20}$"
      }
    },
    {
      "field": "email",
      "label": "Email",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
      }
    },
    {
      "field": "gstNo",
      "label": "GSTIN",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
      }
    },
    {
      "field": "address",
      "label": "Address",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 400
      }
    },
    {
      "field": "category",
      "label": "Category",
      "type": "string",
      "input": "select",
      "required": false,
      "validation": {
        "enum": [
          "cement",
          "steel",
          "aggregates",
          "consumables",
          "electrical",
          "plumbing",
          "finishes",
          "other"
        ]
      }
    },
    {
      "field": "isActive",
      "label": "Active",
      "type": "boolean",
      "input": "toggle",
      "required": true,
      "default": true
    }
  ],
  "relations": {},
  "indexes": [
    [
      "name"
    ],
    [
      "category"
    ],
    [
      "isActive"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
