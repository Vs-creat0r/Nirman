{
  "$schema": "contract.v1",
  "name": "projects",
  "label": "Project",
  "version": "1.0.0",
  "description": "A construction project / tender under which sites and BOQ items live.",
  "fields": [
    {
      "field": "name",
      "label": "Project name",
      "type": "string",
      "input": "text",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 180
      }
    },
    {
      "field": "code",
      "label": "Project code",
      "type": "string",
      "input": "text",
      "required": true,
      "validation": {
        "pattern": "^[A-Z0-9\\-]{2,20}$"
      },
      "help": "Short uppercase code used in document reference numbers"
    },
    {
      "field": "client",
      "label": "Client",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 180
      }
    },
    {
      "field": "startDate",
      "label": "Start date",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "endDate",
      "label": "Target completion",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "tenderFileId",
      "label": "Tender document",
      "type": "file",
      "input": "file",
      "required": false
    },
    {
      "field": "status",
      "label": "Status",
      "type": "enum",
      "input": "readonly-badge",
      "required": true,
      "validation": {
        "enum": [
          "active",
          "on_hold",
          "closed"
        ]
      },
      "default": "active"
    }
  ],
  "relations": {},
  "indexes": [
    [
      "code"
    ],
    [
      "status"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
