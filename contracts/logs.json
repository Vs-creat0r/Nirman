{
  "$schema": "contract.v1",
  "name": "logs",
  "label": "Audit Log",
  "version": "1.0.0",
  "description": "One row per state transition. Written exclusively by the transition() helper; never edited or deleted.",
  "fields": [
    {
      "field": "actorId",
      "label": "Actor",
      "type": "reference",
      "input": "readonly",
      "required": true,
      "relation": {
        "table": "users"
      }
    },
    {
      "field": "actorRole",
      "label": "Actor role",
      "type": "enum",
      "input": "readonly",
      "required": true,
      "validation": {
        "enum": [
          "admin",
          "project_manager",
          "procurement_officer",
          "site_supervisor"
        ]
      }
    },
    {
      "field": "action",
      "label": "Action",
      "type": "string",
      "input": "readonly",
      "required": true,
      "validation": {
        "maxLength": 60
      },
      "help": "e.g. mr_submitted, mr_approved, cc_queried, po_approved, delivered"
    },
    {
      "field": "documentType",
      "label": "Document type",
      "type": "enum",
      "input": "readonly",
      "required": true,
      "validation": {
        "enum": [
          "material_request",
          "rfq",
          "cost_comparison",
          "purchase_order",
          "delivery_challan",
          "grn",
          "vendors",
          "users",
          "projects",
          "stock_movements",
          "inventory"
        ]
      }
    },
    {
      "field": "documentId",
      "label": "Document id",
      "type": "string",
      "input": "readonly",
      "required": true,
      "validation": {
        "maxLength": 60
      }
    },
    {
      "field": "referenceId",
      "label": "Reference",
      "type": "string",
      "input": "readonly",
      "required": true,
      "validation": {
        "maxLength": 40
      },
      "help": "Human-readable ref such as MR-2026-0148; links back to the document"
    },
    {
      "field": "fromStatus",
      "label": "From",
      "type": "string",
      "input": "readonly",
      "required": false,
      "validation": {
        "maxLength": 40
      }
    },
    {
      "field": "toStatus",
      "label": "To",
      "type": "string",
      "input": "readonly",
      "required": false,
      "validation": {
        "maxLength": 40
      }
    },
    {
      "field": "note",
      "label": "Note",
      "type": "text",
      "input": "readonly",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "timestamp",
      "label": "Timestamp",
      "type": "date",
      "input": "readonly",
      "required": true
    }
  ],
  "relations": {
    "actorId": "users"
  },
  "indexes": [
    [
      "timestamp"
    ],
    [
      "documentType",
      "documentId"
    ],
    [
      "actorId"
    ],
    [
      "referenceId"
    ]
  ],
  "audit": {
    "enabled": false
  }
}
