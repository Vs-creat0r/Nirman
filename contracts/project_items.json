{
  "$schema": "contract.v1",
  "name": "project_items",
  "label": "Project Item (BOQ)",
  "version": "1.0.0",
  "description": "A line on the project's master tender / BOQ item list.",
  "fields": [
    {
      "field": "projectId",
      "label": "Project",
      "type": "reference",
      "input": "select",
      "required": true,
      "relation": {
        "table": "projects"
      },
      "optionsFrom": "projects"
    },
    {
      "field": "itemName",
      "label": "Item",
      "type": "string",
      "input": "text",
      "required": true,
      "validation": {
        "minLength": 1,
        "maxLength": 180
      }
    },
    {
      "field": "category",
      "label": "Category",
      "type": "string",
      "input": "select",
      "required": false,
      "validation": {
        "enum": [
          "cement",
          "steel",
          "aggregates",
          "consumables",
          "electrical",
          "plumbing",
          "finishes",
          "other"
        ]
      }
    },
    {
      "field": "subcategory",
      "label": "Subcategory",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 100
      }
    },
    {
      "field": "unit",
      "label": "Unit",
      "type": "string",
      "input": "select",
      "required": true,
      "validation": {
        "enum": [
          "bags",
          "MT",
          "kg",
          "nos",
          "cum",
          "brass",
          "sqm",
          "ltr",
          "rmt"
        ]
      }
    },
    {
      "field": "boqQty",
      "label": "BOQ quantity",
      "type": "number",
      "input": "number",
      "required": true,
      "validation": {
        "min": 0
      }
    },
    {
      "field": "procuredQty",
      "label": "Procured to date",
      "type": "number",
      "input": "readonly",
      "required": true,
      "validation": {
        "min": 0
      },
      "default": 0,
      "help": "Quantity physically received at site via confirmed GRNs"
    },
    {
      "field": "committedQty",
      "label": "Committed on POs",
      "type": "number",
      "input": "readonly",
      "required": false,
      "validation": {
        "min": 0
      },
      "default": 0,
      "help": "Quantity committed on approved POs, not yet received"
    },
    {
      "field": "estimatedRate",
      "label": "Estimated rate",
      "type": "number",
      "input": "number",
      "required": false,
      "validation": {
        "min": 0
      }
    },
    {
      "field": "description",
      "label": "Description",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 600
      }
    }
  ],
  "relations": {
    "projectId": "projects"
  },
  "indexes": [
    [
      "projectId"
    ],
    [
      "projectId",
      "category"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
