{
  "$schema": "contract.v1",
  "name": "purchase_order",
  "label": "Purchase Order",
  "version": "1.0.0",
  "description": "Formal order to the selected vendor. Line items are snapshotted from the approved cost comparison.",
  "fields": [
    {
      "field": "refNo",
      "label": "Reference",
      "type": "string",
      "input": "readonly-badge",
      "required": true
    },
    {
      "field": "costComparisonId",
      "label": "Cost comparison",
      "type": "reference",
      "input": "hidden",
      "required": false,
      "relation": {
        "table": "cost_comparison"
      }
    },
    {
      "field": "materialRequestId",
      "label": "Material request",
      "type": "reference",
      "input": "hidden",
      "required": false,
      "relation": {
        "table": "material_request"
      }
    },
    {
      "field": "vendorId",
      "label": "Vendor",
      "type": "reference",
      "input": "select",
      "required": true,
      "relation": {
        "table": "vendors"
      },
      "optionsFrom": "vendors"
    },
    {
      "field": "projectId",
      "label": "Project",
      "type": "reference",
      "input": "readonly",
      "required": true,
      "relation": {
        "table": "projects"
      }
    },
    {
      "field": "siteId",
      "label": "Deliver to site",
      "type": "reference",
      "input": "select",
      "required": false,
      "relation": {
        "table": "sites"
      },
      "optionsFrom": "sites"
    },
    {
      "field": "lineItems",
      "label": "Line items",
      "type": "array",
      "input": "item-list",
      "required": true,
      "items": {
        "type": "object",
        "fields": [
          {
            "field": "itemName",
            "label": "Item",
            "type": "string",
            "input": "text",
            "required": true
          },
          {
            "field": "quantity",
            "label": "Qty",
            "type": "number",
            "input": "number",
            "required": true,
            "validation": {
              "min": 0.001
            }
          },
          {
            "field": "unit",
            "label": "Unit",
            "type": "string",
            "input": "text",
            "required": true
          },
          {
            "field": "hsnSacCode",
            "label": "HSN/SAC Code",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 20
            }
          },
          {
            "field": "rate",
            "label": "Rate",
            "type": "number",
            "input": "number",
            "required": true,
            "validation": {
              "min": 0
            }
          },
          {
            "field": "amount",
            "label": "Amount",
            "type": "number",
            "input": "readonly",
            "required": true,
            "help": "quantity x rate, computed server-side"
          },
          {
            "field": "projectItemId",
            "label": "Project BOQ Item",
            "type": "reference",
            "input": "hidden",
            "required": false,
            "relation": {
              "table": "project_items"
            }
          },
          {
            "field": "isUnquotedAddition",
            "label": "Unquoted addition",
            "type": "boolean",
            "input": "checkbox",
            "required": false,
            "default": false
          },
          {
            "field": "additionReason",
            "label": "Addition reason",
            "type": "string",
            "input": "text",
            "required": false,
            "validation": {
              "maxLength": 300
            }
          }
        ]
      },
      "validation": {
        "minLength": 1
      }
    },
    {
      "field": "subtotal",
      "label": "Subtotal",
      "type": "number",
      "input": "readonly",
      "required": true,
      "validation": {
        "min": 0
      }
    },
    {
      "field": "freight",
      "label": "Freight",
      "type": "number",
      "input": "number",
      "required": false,
      "validation": {
        "min": 0
      },
      "default": 0
    },
    {
      "field": "taxRate",
      "label": "GST %",
      "type": "number",
      "input": "number",
      "required": true,
      "validation": {
        "min": 0,
        "max": 100
      },
      "default": 18
    },
    {
      "field": "taxAmount",
      "label": "GST amount",
      "type": "number",
      "input": "readonly",
      "required": true,
      "validation": {
        "min": 0
      }
    },
    {
      "field": "totalAmount",
      "label": "Total",
      "type": "number",
      "input": "readonly",
      "required": true,
      "validation": {
        "min": 0
      }
    },
    {
      "field": "placeOfSupplyStateCode",
      "label": "Place of supply (State code)",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 2
      }
    },
    {
      "field": "siteContactPerson",
      "label": "Site contact person",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 100
      }
    },
    {
      "field": "siteContactPhone",
      "label": "Site contact phone",
      "type": "string",
      "input": "text",
      "required": false,
      "validation": {
        "maxLength": 20
      }
    },
    {
      "field": "unloadingScope",
      "label": "Unloading scope",
      "type": "enum",
      "input": "select",
      "required": false,
      "validation": {
        "enum": [
          "buyer_scope",
          "vendor_scope"
        ]
      },
      "default": "buyer_scope"
    },
    {
      "field": "freightTerms",
      "label": "Freight terms",
      "type": "enum",
      "input": "select",
      "required": false,
      "validation": {
        "enum": [
          "inclusive_in_rate",
          "extra_at_actuals",
          "fixed_freight",
          "to_pay_by_site"
        ]
      },
      "default": "inclusive_in_rate"
    },
    {
      "field": "procurementNotes",
      "label": "Procurement notes",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "paymentTerms",
      "label": "Payment terms",
      "type": "enum",
      "input": "select",
      "required": true,
      "validation": {
        "enum": [
          "advance",
          "on_delivery",
          "7_days",
          "15_days",
          "30_days",
          "45_days"
        ]
      },
      "default": "30_days"
    },
    {
      "field": "expectedDelivery",
      "label": "Expected delivery",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "validUntil",
      "label": "Valid until",
      "type": "date",
      "input": "date",
      "required": false
    },
    {
      "field": "termsAndConditions",
      "label": "Terms & Conditions",
      "type": "text",
      "input": "textarea",
      "required": false
    },
    {
      "field": "tcTemplateId",
      "label": "T&C Template",
      "type": "reference",
      "input": "hidden",
      "required": false,
      "relation": {
        "table": "tc_templates"
      }
    },
    {
      "field": "deliveredQty",
      "label": "Delivered qty",
      "type": "number",
      "input": "readonly",
      "required": false,
      "validation": {
        "min": 0
      },
      "default": 0,
      "help": "Sprint 2: drives partial delivery / Pending POs"
    },
    {
      "field": "pendingQty",
      "label": "Pending qty",
      "type": "number",
      "input": "readonly",
      "required": false,
      "validation": {
        "min": 0
      },
      "default": 0
    },
    {
      "field": "pdfFileId",
      "label": "PO document",
      "type": "file",
      "input": "readonly",
      "required": false
    },
    {
      "field": "status",
      "label": "Status",
      "type": "enum",
      "input": "readonly-badge",
      "required": true,
      "validation": {
        "enum": [
          "draft",
          "submitted",
          "queried",
          "rejected",
          "approved",
          "cancelled",
          "closed"
        ]
      },
      "default": "draft"
    },
    {
      "field": "cancellationReason",
      "label": "Cancellation reason",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "closureType",
      "label": "Closure type",
      "type": "enum",
      "input": "readonly-badge",
      "required": false,
      "validation": {
        "enum": [
          "cancelled",
          "short_closed",
          "fully_received"
        ]
      }
    },
    {
      "field": "reviewNote",
      "label": "Reviewer note",
      "type": "text",
      "input": "textarea",
      "required": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "field": "reviewedBy",
      "label": "Reviewed by",
      "type": "reference",
      "input": "readonly",
      "required": false,
      "relation": {
        "table": "users"
      }
    },
    {
      "field": "reviewedAt",
      "label": "Reviewed at",
      "type": "date",
      "input": "readonly",
      "required": false
    }
  ],
  "statuses": [
    "draft",
    "submitted",
    "queried",
    "rejected",
    "approved",
    "cancelled",
    "closed"
  ],
  "lifecycle": {
    "initial": "draft",
    "states": {
      "draft": {
        "kind": "editable",
        "owner": "creator",
        "terminal": false,
        "badge": {
          "label": "Draft",
          "variant": "secondary"
        }
      },
      "submitted": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Submitted",
          "variant": "default"
        }
      },
      "queried": {
        "kind": "editable",
        "owner": "creator",
        "terminal": false,
        "badge": {
          "label": "Queried",
          "variant": "destructive"
        }
      },
      "approved": {
        "kind": "locked",
        "owner": "none",
        "terminal": false,
        "badge": {
          "label": "Approved",
          "variant": "default"
        }
      },
      "rejected": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Rejected",
          "variant": "destructive"
        }
      },
      "cancelled": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Cancelled",
          "variant": "destructive"
        }
      },
      "closed": {
        "kind": "closed",
        "owner": "none",
        "terminal": true,
        "badge": {
          "label": "Closed",
          "variant": "secondary"
        }
      }
    },
    "transitions": [
      {
        "name": "submit",
        "label": "Submit for Approval",
        "from": [
          "draft",
          "queried"
        ],
        "to": "submitted",
        "roles": [
          "procurement_officer",
          "project_manager",
          "admin"
        ],
        "actor": "creator",
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "ready_for_po",
              "review_po"
            ],
            "to": "review_po"
          }
        ]
      },
      {
        "name": "approve",
        "label": "Approve Purchase Order",
        "from": [
          "submitted"
        ],
        "to": "approved",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "review_po",
              "ready_for_po"
            ],
            "to": "pending_po"
          }
        ]
      },
      {
        "name": "reject",
        "label": "Reject Purchase Order",
        "from": [
          "submitted"
        ],
        "to": "rejected",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "requiresNote": true,
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "review_po"
            ],
            "to": "ready_for_po"
          }
        ]
      },
      {
        "name": "query",
        "label": "Query Purchase Order",
        "from": [
          "submitted"
        ],
        "to": "queried",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "requiresNote": true
      },
      {
        "name": "resubmit",
        "label": "Resubmit Purchase Order",
        "from": [
          "queried"
        ],
        "to": "submitted",
        "roles": [
          "procurement_officer",
          "project_manager",
          "admin"
        ],
        "actor": "creator",
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "ready_for_po",
              "review_po"
            ],
            "to": "review_po"
          }
        ]
      },
      {
        "name": "cancel",
        "label": "Cancel Purchase Order",
        "from": [
          "submitted",
          "approved"
        ],
        "to": "cancelled",
        "roles": [
          "project_manager",
          "admin"
        ],
        "actor": "approver",
        "requiresNote": true,
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "review_po",
              "pending_po"
            ],
            "to": "ready_for_po"
          }
        ]
      },
      {
        "name": "close",
        "label": "Close Purchase Order",
        "from": [
          "approved"
        ],
        "to": "closed",
        "roles": [
          "project_manager",
          "admin"
        ],
        "requiresNote": true,
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "pending_po",
              "delivery_processing"
            ],
            "to": "delivered"
          }
        ]
      },
      {
        "name": "close_on_receipt",
        "label": "Close upon Full Receipt",
        "from": [
          "approved",
          "submitted"
        ],
        "to": "closed",
        "roles": [
          "site_supervisor",
          "procurement_officer",
          "admin"
        ],
        "cascades": [
          {
            "table": "material_request",
            "from": [
              "delivery_processing",
              "pending_po"
            ],
            "to": "delivered"
          }
        ]
      }
    ]
  },
  "relations": {
    "costComparisonId": "cost_comparison",
    "materialRequestId": "material_request",
    "vendorId": "vendors",
    "projectId": "projects",
    "siteId": "sites",
    "reviewedBy": "users"
  },
  "indexes": [
    [
      "refNo"
    ],
    [
      "status"
    ],
    [
      "vendorId"
    ],
    [
      "projectId",
      "status"
    ],
    [
      "siteId",
      "status"
    ],
    [
      "costComparisonId"
    ]
  ],
  "audit": {
    "enabled": true,
    "trackCreatedBy": true,
    "trackUpdatedBy": true,
    "trackUpdatedAt": true
  }
}
