# ==============================================================================
# Nirman Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# For Vercel / Production deployments, configure these variables in project settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Deployment Binding (CLI & Backend)
# ------------------------------------------------------------------------------
# Generated automatically by `npx convex dev` during local setup.
# Example format: dev:my-project-name
CONVEX_DEPLOYMENT=your_convex_deployment_identifier

# ------------------------------------------------------------------------------
# 2. Public Convex Cloud URL (Frontend & Client SDK)
# ------------------------------------------------------------------------------
# The primary HTTPS endpoint for Convex queries, mutations, and subscriptions.
# Example format: https://my-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ------------------------------------------------------------------------------
# 3. Public Convex HTTP / Site Actions URL (Optional / Auth)
# ------------------------------------------------------------------------------
# The HTTP actions and webhook endpoint for Convex.
# Example format: https://my-deployment.convex.site
CONVEX_SITE_URL=https://your-deployment-name.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ------------------------------------------------------------------------------
# 4. CI / Vercel Build-time Deployment Key (Production Only - DO NOT COMMIT KEY)
# ------------------------------------------------------------------------------
# Generated in Convex Dashboard -> Settings -> Deployment Keys
# Used by Vercel / CI build command: `npx convex deploy --cmd 'npm run build'`
# CONVEX_DEPLOY_KEY=your_production_deploy_key_here
